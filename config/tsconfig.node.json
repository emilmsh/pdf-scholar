{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    // Cheap strictness on top of strict: all four cost zero errors today, and
    // they are here to stop that from changing quietly. noUnusedParameters is
    // included deliberately — an unused prop is usually a prop that stopped
    // being threaded through.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["../src/main", "../src/preload", "../src/shared", "electron.vite.config.ts", "vite.web.config.ts", "vite.extension.config.ts"]
}
