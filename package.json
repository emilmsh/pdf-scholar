{
  "name": "pdfx",
  "productName": "PDF Scholar",
  "version": "0.38.1",
  "description": "A PDF reader and annotator for Windows, built for research",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev --config config/electron.vite.config.ts",
    "dev:web": "vite --config config/vite.web.config.ts",
    "dev:ext": "vite build --watch --config config/vite.extension.config.ts",
    "build": "electron-vite build --config config/electron.vite.config.ts",
    "build:ext": "vite build --config config/vite.extension.config.ts",
    "pack:ext": "npm run build:ext && node scripts/pack-extension.mjs",
    "pack:ext:store": "npm run build:ext && node scripts/pack-extension.mjs --store",
    "icons:app": "electron scripts/render-icon.cjs",
    "icons:ext": "electron scripts/render-extension-icons.cjs",
    "icons:appx": "electron scripts/render-appx-tiles.cjs",
    "icons:store": "electron scripts/render-store-assets.cjs",
    "start": "electron-vite preview --config config/electron.vite.config.ts",
    "typecheck": "tsc --noEmit -p config/tsconfig.web.json && tsc --noEmit -p config/tsconfig.node.json && tsc --noEmit -p config/tsconfig.extension.json",
    "sample": "node scripts/make-sample-pdf.mjs",
    "shoot": "node scripts/shoot-screenshots.mjs",
    "shoot:store": "electron scripts/scale-store-shots.cjs",
    "check:shots": "node scripts/check-screenshots.mjs",
    "check:css": "node scripts/check-dead-css.mjs",
    "check:models": "node scripts/check-models.mjs",
    "test:engine": "esbuild src/main/annotation-engine-embedpdf.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.engine-test-bundle.mjs && node scripts/test-engine-embedpdf.mjs",
    "test:margin": "esbuild src/shared/margin-export.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.margin-test-bundle.mjs && node scripts/test-margin-export.mjs",
    "test:appender": "node scripts/test-appender.mjs",
    "test:cache": "node scripts/test-engine-cache.mjs",
    "test:rotation": "node scripts/test-rotation.mjs",
    "test:retrieval": "node scripts/test-ai-retrieval.mjs",
    "test:ai-chat": "node scripts/test-ai-chat.mjs",
    "test:viewer-url": "node scripts/test-viewer-url.mjs",
    "test:insecure-retry": "node scripts/test-insecure-retry.mjs",
    "test:file-access": "node scripts/test-file-access.mjs",
    "test:update-channel": "node scripts/test-update-channel.mjs",
    "test:annot-edit": "node scripts/test-annot-edit.mjs",
    "test:pen": "node scripts/test-pen.mjs",
    "test:ai-settings": "node scripts/test-ai-settings.mjs",
    "test:windows": "node scripts/test-multiwindow.mjs",
    "test:assistant": "node scripts/test-assistant-window.mjs",
    "test:torn-read": "node scripts/test-torn-read.mjs",
    "test:listing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-store-listing.ps1",
    "test:ext-publish": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/ext-publish.ps1 -CheckOnly",
    "bench:engine": "node scripts/engine-bench.mjs",
    "dist": "npm run build && electron-builder --win --config config/electron-builder.yml",
    "dist:linux": "npm run build && electron-builder --linux --config config/electron-builder.yml",
    "dist:mac": "npm run build && electron-builder --mac --config config/electron-builder.yml",
    "dist:store": "npm run build && electron-builder --win --config config/electron-builder.store.yml",
    "test:password": "esbuild src/main/annotation-engine-embedpdf.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.engine-test-bundle.mjs && node scripts/test-password.mjs",
    "test:signatures": "esbuild src/main/annotation-engine-embedpdf.ts --bundle --platform=node --format=esm --packages=external --outfile=scripts/.engine-test-bundle.mjs && node scripts/test-signatures.mjs",
    "test:signature-stamp": "node scripts/test-signature-stamp.mjs"
  },
  "author": "Emil Mathias Strøm Halseth",
  "license": "MIT",
  "//dependencies": "Runtime-only: electron-builder packs everything here into the installer. Anything the RENDERER imports is bundled by vite instead (externalizeDepsPlugin runs for main/preload only) and belongs in devDependencies — listing it here ships a second, unused copy.",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.111.0",
    "@embedpdf/engines": "^2.14.4",
    "@embedpdf/models": "^2.14.4",
    "@embedpdf/pdfium": "^2.14.4",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.25.12",
    "katex": "^0.18.1",
    "mupdf": "1.28.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.1.200",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
